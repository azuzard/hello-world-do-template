{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hello-world-do-template",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"upload_source_maps": true,
	"migrations": [
		{
			"new_sqlite_classes": [
				"WebSocketServer"
			],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "WEBSOCKET_SERVER",
				"class_name": "WebSocketServer"
			}
		]
	},
	"observability": {
		"enabled": true
	}
}